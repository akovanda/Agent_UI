# Generated by ./hub init. Copying this file manually is not recommended.
COMPOSE_PROJECT_NAME=local-ai-hub
BIND_ADDRESS=127.0.0.1

# Docker images. Pin these in .env for repeatable production upgrades.
POSTGRES_IMAGE=pgvector/pgvector:pg16
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
SILLYTAVERN_IMAGE=ghcr.io/sillytavern/sillytavern:latest
HERMES_IMAGE=nousresearch/hermes-agent:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
TOOLBOX_IMAGE=local-ai-hub-toolbox:0.2.0
GATEWAY_IMAGE=local-ai-hub-gateway:0.2.0

# Named volumes. Keeping names explicit lets ./hub use them without parsing Compose internals.
POSTGRES_VOLUME=local-ai-hub-postgres
MODELS_VOLUME=local-ai-hub-models
RUNTIME_CONFIG_VOLUME=local-ai-hub-runtime-config
HUB_STATE_VOLUME=local-ai-hub-state
GATEWAY_STATE_VOLUME=local-ai-hub-gateway-state
OPEN_WEBUI_VOLUME=local-ai-hub-open-webui
SILLYTAVERN_CONFIG_VOLUME=local-ai-hub-sillytavern-config
SILLYTAVERN_DATA_VOLUME=local-ai-hub-sillytavern-data
SILLYTAVERN_PLUGINS_VOLUME=local-ai-hub-sillytavern-plugins
SILLYTAVERN_EXTENSIONS_VOLUME=local-ai-hub-sillytavern-extensions
HERMES_VOLUME=local-ai-hub-hermes
PROMETHEUS_VOLUME=local-ai-hub-prometheus

# Runtime tuning for the single Tesla T4. The catalog owns per-model settings.
NVIDIA_VISIBLE_DEVICES=all
LLAMA_MODELS_MAX=1
LLAMA_FIT_TARGET_MIB=1024
GATEWAY_WORKERS=1
GATEWAY_APP=

# These are generated as unused high loopback ports by ./hub init.
POSTGRES_HOST_PORT=
LLAMA_HOST_PORT=
GATEWAY_HOST_PORT=
OPEN_WEBUI_HOST_PORT=
SILLYTAVERN_HOST_PORT=
HERMES_API_HOST_PORT=
HERMES_DASHBOARD_HOST_PORT=
PROMETHEUS_HOST_PORT=

# These are generated as cryptographically random values by ./hub init.
POSTGRES_USER=local_ai_hub
POSTGRES_PASSWORD=
LLAMA_API_KEY=
GATEWAY_API_KEY=
WEBUI_SECRET_KEY=
HERMES_API_KEY=
HERMES_DASHBOARD_USERNAME=andrew
HERMES_DASHBOARD_PASSWORD=

# Feature switches. Compose profiles still control whether optional services run.
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_ENABLE_MEMORIES=false
HERMES_DASHBOARD_ENABLED=1

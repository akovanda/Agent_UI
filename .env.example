# Generated by ./hub init. Copying this file manually is not recommended.
COMPOSE_PROJECT_NAME=agent-ui
BIND_ADDRESS=127.0.0.1

# Docker images. Pin immutable tags or digests for repeatable production upgrades.
POSTGRES_IMAGE=pgvector/pgvector:pg16
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.8.22-9fea41204@sha256:11a9b34cdc0b1ec2b991470a2762ecb5a1a531898289fb51dcd015260450729e
OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal:slim@sha256:08b734e9aa1d760f5c37658d25f36e66d0c102fe817225bc4008aef45a797f7c
SILLYTAVERN_IMAGE=ghcr.io/sillytavern/sillytavern:latest
HERMES_IMAGE=nousresearch/hermes-agent:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
TOOLBOX_IMAGE=agent-ui-toolbox:0.3.0
GATEWAY_IMAGE=agent-ui-gateway:0.3.0

# Explicit named volumes make backup, restore, and AI-operated setup deterministic.
POSTGRES_VOLUME=agent-ui-postgres
MODELS_VOLUME=agent-ui-models
RUNTIME_CONFIG_VOLUME=agent-ui-runtime-config
RUNTIME_CONFIG_UID=10001
RUNTIME_CONFIG_GID=10001
HUB_STATE_VOLUME=agent-ui-state
GATEWAY_STATE_VOLUME=agent-ui-gateway-state
OPEN_WEBUI_VOLUME=agent-ui-open-webui
SEARXNG_DATA_VOLUME=agent-ui-searxng-data
OPEN_TERMINAL_DATA_VOLUME=agent-ui-open-terminal-data
SILLYTAVERN_CONFIG_VOLUME=agent-ui-sillytavern-config
SILLYTAVERN_DATA_VOLUME=agent-ui-sillytavern-data
SILLYTAVERN_PLUGINS_VOLUME=agent-ui-sillytavern-plugins
SILLYTAVERN_EXTENSIONS_VOLUME=agent-ui-sillytavern-extensions
HERMES_VOLUME=agent-ui-hermes
PROMETHEUS_VOLUME=agent-ui-prometheus

# Runtime policy. Per-model inference settings live in the catalog overlay.
NVIDIA_VISIBLE_DEVICES=all
LLAMA_MODELS_MAX=1
LLAMA_FIT_TARGET_MIB=1024
GATEWAY_WORKERS=1
GATEWAY_APP=
DEFAULT_USER_ID=local-user

# Generated as unused high loopback ports by ./hub init.
POSTGRES_HOST_PORT=
LLAMA_HOST_PORT=
GATEWAY_HOST_PORT=
OPEN_WEBUI_HOST_PORT=
SILLYTAVERN_HOST_PORT=
HERMES_API_HOST_PORT=
HERMES_DASHBOARD_HOST_PORT=
PROMETHEUS_HOST_PORT=

# Generated as cryptographically random values by ./hub init.
POSTGRES_USER=agent_ui
POSTGRES_PASSWORD=
LLAMA_API_KEY=
GATEWAY_API_KEY=
WEBUI_SECRET_KEY=
SEARXNG_SECRET_KEY=
OPEN_TERMINAL_API_KEY=
HERMES_API_KEY=
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=

# Optional external backends may reference any *_ENV name declared in the catalog.
# These examples are intentionally blank and inactive until a backend uses them.
EXTERNAL_OPENAI_BASE_URL=
EXTERNAL_OPENAI_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_API_KEY=

# Human-facing feature switches. Compose profiles decide which optional UIs run.
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_ENABLE_MEMORIES=false
OPEN_WEBUI_ENABLE_CODE_EXECUTION=true
OPEN_WEBUI_ENABLE_CODE_INTERPRETER=true
OPEN_WEBUI_CODE_INTERPRETER_ENGINE=pyodide
OPEN_WEBUI_ENABLE_NOTES=true
OPEN_WEBUI_ENABLE_CALENDAR=true
OPEN_WEBUI_ENABLE_AUTOMATIONS=true
OPEN_WEBUI_ENABLE_WEB_SEARCH=false
OPEN_WEBUI_ENABLE_WEB_SEARCH_CONFIRMATION=true
OPEN_WEBUI_WEB_SEARCH_RESULT_COUNT=3
OPEN_WEBUI_SEARXNG_LANGUAGE=all
OPEN_TERMINAL_ALLOWED_DOMAINS=github.com,githubusercontent.com,gitlab.com
HERMES_DASHBOARD_ENABLED=1

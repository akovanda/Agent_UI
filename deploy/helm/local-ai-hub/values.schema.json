{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "secrets": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "postgresUser": {"type": "string"},
        "postgresPassword": {"type": "string"},
        "llamaApiKey": {"type": "string"},
        "gatewayApiKey": {"type": "string"},
        "webuiSecretKey": {"type": "string"},
        "hermesApiKey": {"type": "string"}
      }
    },
    "llama": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "modelsMax": {"type": "integer", "minimum": 1},
        "fitTargetMiB": {"type": "integer", "minimum": 128},
        "gpuCount": {"type": "integer", "minimum": 0},
        "extraVolumes": {"type": "array", "items": {"type": "object"}},
        "extraVolumeMounts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "containerPath"],
        "properties": {
          "enabled": {"type": "boolean"},
          "containerPath": {"type": "string"},
          "upstreamModel": {"type": "string"},
          "displayName": {"type": "string"},
          "backend": {"type": "string"},
          "priority": {"type": "integer"},
          "capabilities": {"type": "object"},
          "features": {"type": "object"},
          "contextSize": {"type": "integer", "minimum": 1},
          "gpuLayers": {},
          "cpuMoeLayers": {"type": "integer", "minimum": 0},
          "cacheTypeK": {"type": "string"},
          "cacheTypeV": {"type": "string"}
        }
      }
    },
    "experiences": {"type": "object"},
    "hubProfiles": {"type": "object"},
    "gateway": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 1},
        "extraEnv": {"type": "array", "items": {"type": "object"}}
      }
    },
    "openWebUI": {"type": "object"},
    "sillyTavern": {"type": "object"},
    "hermes": {"type": "object"},
    "ingress": {"type": "object"},
    "networkPolicy": {"type": "object"},
    "serviceMonitor": {"type": "object"}
  }
}

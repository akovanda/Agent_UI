{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["secrets", "postgres", "llama", "gateway", "openWebUI"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "storage": {
      "type": "object",
      "required": ["size", "storageClass", "existingClaim", "accessModes"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"},
        "existingClaim": {"type": "string"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "secrets": {
      "type": "object",
      "required": ["create", "existingSecret"],
      "properties": {
        "create": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "postgresUser": {"type": "string"},
        "postgresPassword": {"type": "string"},
        "llamaApiKey": {"type": "string"},
        "gatewayApiKey": {"type": "string"},
        "webuiSecretKey": {"type": "string"},
        "hermesApiKey": {"type": "string"}
      }
    },
    "postgres": {
      "type": "object",
      "required": ["enabled", "image", "service", "storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "storage": {"$ref": "#/definitions/storage"}
      }
    },
    "llama": {
      "type": "object",
      "required": ["enabled", "image", "service", "storage", "modelsMax", "fitTargetMiB", "gpuCount"],
      "properties": {
        "enabled": {"type": "boolean"},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "storage": {"$ref": "#/definitions/storage"},
        "modelsMax": {"type": "integer", "minimum": 1},
        "fitTargetMiB": {"type": "integer", "minimum": 128},
        "gpuCount": {"type": "integer", "minimum": 0},
        "extraVolumes": {"type": "array", "items": {"type": "object"}},
        "extraVolumeMounts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "containerPath"],
        "properties": {
          "enabled": {"type": "boolean"},
          "containerPath": {"type": "string"},
          "upstreamModel": {"type": "string"},
          "displayName": {"type": "string"},
          "backend": {"type": "string"},
          "priority": {"type": "integer"},
          "capabilities": {"type": "object"},
          "features": {"type": "object"},
          "contextSize": {"type": "integer", "minimum": 1},
          "gpuLayers": {},
          "cpuMoeLayers": {"type": "integer", "minimum": 0},
          "cacheTypeK": {"type": "string"},
          "cacheTypeV": {"type": "string"}
        }
      }
    },
    "experiences": {"type": "object"},
    "hubProfiles": {"type": "object"},
    "gateway": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "workers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "workers": {"type": "integer", "minimum": 1},
        "extraEnv": {"type": "array", "items": {"type": "object"}}
      }
    },
    "openWebUI": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "storage", "enableSignup", "enableMemories"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "storage": {"$ref": "#/definitions/storage"},
        "enableSignup": {"type": "boolean"},
        "enableMemories": {"type": "boolean"}
      }
    },
    "sillyTavern": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "storage": {"$ref": "#/definitions/storage"}
      }
    },
    "hermes": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "storage", "model", "contextLength", "dashboard"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "podAnnotations": {"type": "object"},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object",
          "required": ["type", "apiPort", "dashboardPort"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "apiPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "dashboardPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "storage": {"$ref": "#/definitions/storage"},
        "model": {"type": "string", "minLength": 1},
        "contextLength": {"type": "integer", "minimum": 1},
        "dashboard": {
          "type": "object",
          "required": ["enabled", "username", "password"],
          "properties": {
            "enabled": {"type": "boolean"},
            "username": {"type": "string"},
            "password": {"type": "string"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "hosts", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType", "service"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]},
                    "service": {"type": "string", "minLength": 1},
                    "port": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "tls": {"type": "array", "items": {"type": "object"}}
      }
    },
    "networkPolicy": {"type": "object"},
    "serviceMonitor": {"type": "object"},
    "catalog": {"type": "object"}
  }
}

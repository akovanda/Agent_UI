#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${AGENT_UI_ENV_FILE:-$ROOT/.env}"
COMPOSE_FILE="${AGENT_UI_COMPOSE_FILE:-$ROOT/compose.yaml}"
GENERATED_DIR="$ROOT/.agent-ui"
COMPOSE_OVERRIDE="$GENERATED_DIR/compose.sources.yaml"
K8S_VALUES="$GENERATED_DIR/k8s-values.yaml"
DEFAULT_TOOLBOX_IMAGE="agent-ui-toolbox:0.3.0"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is required"
  docker version >/dev/null 2>&1 || fail "Docker daemon is not reachable"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required"
}

env_value() {
  local key="$1" fallback="${2:-}" value=""
  if [[ -f "$ENV_FILE" ]]; then
    value="$(sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1)"
  fi
  printf '%s' "${value:-$fallback}"
}

toolbox_image() {
  env_value TOOLBOX_IMAGE "$DEFAULT_TOOLBOX_IMAGE"
}

compose() {
  require_docker
  [[ -f "$ENV_FILE" ]] || fail "Run ./hub init first"
  local command=(
    docker compose
    --project-directory "$ROOT"
    --env-file "$ENV_FILE"
    -f "$COMPOSE_FILE"
  )
  if [[ -s "$COMPOSE_OVERRIDE" ]]; then
    command+=(-f "$COMPOSE_OVERRIDE")
  fi
  "${command[@]}" "$@"
}

build_toolbox() {
  require_docker
  docker build \
    --file "$ROOT/deploy/docker/toolbox.Dockerfile" \
    --tag "$(toolbox_image)" \
    "$ROOT"
}

create_volumes() {
  local keys=(
    POSTGRES_VOLUME MODELS_VOLUME RUNTIME_CONFIG_VOLUME HUB_STATE_VOLUME
    GATEWAY_STATE_VOLUME OPEN_WEBUI_VOLUME SILLYTAVERN_CONFIG_VOLUME
    SILLYTAVERN_DATA_VOLUME SILLYTAVERN_PLUGINS_VOLUME
    SILLYTAVERN_EXTENSIONS_VOLUME HERMES_VOLUME PROMETHEUS_VOLUME
  )
  local key name
  for key in "${keys[@]}"; do
    name="$(env_value "$key")"
    [[ -n "$name" ]] || fail "$key is empty in $ENV_FILE"
    docker volume create "$name" >/dev/null
  done
}

direct_toolbox() {
  local model_volume runtime_volume state_volume hermes_volume
  model_volume="$(env_value MODELS_VOLUME agent-ui-models)"
  runtime_volume="$(env_value RUNTIME_CONFIG_VOLUME agent-ui-runtime)"
  state_volume="$(env_value HUB_STATE_VOLUME agent-ui-state)"
  hermes_volume="$(env_value HERMES_VOLUME agent-ui-hermes)"
  docker run --rm \
    --network host \
    --env-file "$ENV_FILE" \
    ${HF_TOKEN:+-e HF_TOKEN} \
    -v "$ROOT:/workspace" \
    -v "$model_volume:/models" \
    -v "$runtime_volume:/runtime" \
    -v "$state_volume:/state" \
    -v "$hermes_volume:/hermes" \
    -w /workspace \
    "$(toolbox_image)" \
    "$@"
}

toolbox() {
  generate_override
  compose run --rm --no-deps toolbox "$@"
}

generate_override() {
  mkdir -p "$GENERATED_DIR"
  direct_toolbox registry compose-override \
    --registry /opt/agent-ui/config/registry.yaml \
    --overlay /state/registry.local.yaml \
    --output /workspace/.agent-ui/compose.sources.yaml
}

render_runtime() {
  generate_override
  compose run --rm --no-deps config-init
}

refresh_runtime() {
  render_runtime
  local running
  running="$(compose ps --status running --services 2>/dev/null || true)"
  if grep -qx llama <<<"$running"; then
    compose restart llama >/dev/null
  fi
  if grep -qx gateway <<<"$running"; then
    compose restart gateway >/dev/null
  fi
}

ensure_initialized() {
  if [[ ! -f "$ENV_FILE" ]]; then
    "$ROOT/hub" init
  fi
}

show_ports() {
  local bind
  bind="$(env_value BIND_ADDRESS 127.0.0.1)"
  cat <<EOF
Open WebUI:       http://${bind}:$(env_value OPEN_WEBUI_HOST_PORT)
SillyTavern:      http://${bind}:$(env_value SILLYTAVERN_HOST_PORT)
Gateway API:      http://${bind}:$(env_value GATEWAY_HOST_PORT)/v1
Gateway registry: http://${bind}:$(env_value GATEWAY_HOST_PORT)/api/registry
llama.cpp API:    http://${bind}:$(env_value LLAMA_HOST_PORT)/v1
PostgreSQL:       ${bind}:$(env_value POSTGRES_HOST_PORT)
Hermes API:       http://${bind}:$(env_value HERMES_API_HOST_PORT)/v1
Hermes dashboard: http://${bind}:$(env_value HERMES_DASHBOARD_HOST_PORT)
Prometheus:       http://${bind}:$(env_value PROMETHEUS_HOST_PORT)
EOF
}

find_option_value() {
  local wanted="$1"
  shift
  while (($#)); do
    if [[ "$1" == "$wanted" && $# -ge 2 ]]; then
      printf '%s' "$2"
      return 0
    fi
    shift
  done
  return 1
}

run_with_same_host_path() {
  local host_path="$1"
  shift
  host_path="$(cd "$(dirname "$host_path")" && pwd)/$(basename "$host_path")"
  local parent model_volume runtime_volume state_volume hermes_volume
  parent="$(dirname "$host_path")"
  model_volume="$(env_value MODELS_VOLUME agent-ui-models)"
  runtime_volume="$(env_value RUNTIME_CONFIG_VOLUME agent-ui-runtime)"
  state_volume="$(env_value HUB_STATE_VOLUME agent-ui-state)"
  hermes_volume="$(env_value HERMES_VOLUME agent-ui-hermes)"
  docker run --rm \
    --network host \
    --env-file "$ENV_FILE" \
    -v "$ROOT:/workspace" \
    -v "$model_volume:/models" \
    -v "$runtime_volume:/runtime" \
    -v "$state_volume:/state" \
    -v "$hermes_volume:/hermes" \
    -v "$parent:$parent:ro" \
    -w /workspace \
    "$(toolbox_image)" \
    "$@"
}

registry_command() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    apply)
      local manifest="${1:-}"
      [[ -n "$manifest" ]] || fail "usage: ./hub registry apply FILE.yaml"
      shift
      manifest="$(cd "$(dirname "$manifest")" && pwd)/$(basename "$manifest")"
      [[ -f "$manifest" ]] || fail "Registry manifest does not exist: $manifest"
      run_with_same_host_path "$manifest" registry apply "$manifest" "$@"
      refresh_runtime
      ;;
    show|plan|validate|schema)
      toolbox registry "$sub" "$@"
      ;;
    *)
      fail "registry command must be one of: show, plan, validate, schema, apply"
      ;;
  esac
}

source_command() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add)
      local host_path=""
      host_path="$(find_option_value --host-path "$@" || true)"
      if [[ -n "$host_path" ]]; then
        [[ -d "$host_path" ]] || fail "Host source must be an existing directory: $host_path"
        run_with_same_host_path "$host_path" source add "$@"
      else
        direct_toolbox source add "$@"
      fi
      refresh_runtime
      ;;
    list)
      toolbox source list "$@"
      ;;
    remove)
      direct_toolbox source remove "$@"
      refresh_runtime
      ;;
    *) fail "source command must be one of: add, list, remove" ;;
  esac
}

provider_command() {
  local sub="${1:-}"
  shift || true
  [[ "$sub" == "add" ]] || fail "provider command currently supports: add"
  direct_toolbox provider add "$@"
  refresh_runtime
}

model_command() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    register)
      local host_path=""
      host_path="$(find_option_value --host-path "$@" || true)"
      if [[ -n "$host_path" ]]; then
        [[ -f "$host_path" ]] || fail "Model file does not exist: $host_path"
        run_with_same_host_path "$host_path" model register "$@"
      else
        direct_toolbox model register "$@"
      fi
      refresh_runtime
      ;;
    import)
      local model_id="${1:-}" source="${2:-}"
      [[ -n "$model_id" && -n "$source" ]] || \
        fail "usage: ./hub model import MODEL_ID /path/to/file [--force]"
      shift 2
      source="$(cd "$(dirname "$source")" && pwd)/$(basename "$source")"
      [[ -f "$source" ]] || fail "Model file does not exist: $source"
      local parent name
      parent="$(dirname "$source")"
      name="$(basename "$source")"
      generate_override
      compose run --rm --no-deps \
        -v "$parent:/incoming:ro" \
        toolbox model import "$model_id" --source "/incoming/$name" "$@"
      refresh_runtime
      ;;
    fetch)
      toolbox model fetch "$@"
      refresh_runtime
      ;;
    list|verify)
      toolbox model "$sub" "$@"
      ;;
    remove)
      direct_toolbox model remove "$@"
      refresh_runtime
      ;;
    *) fail "model command must be one of: register, import, fetch, list, verify, remove" ;;
  esac
}

profile_command() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    bind|unbind)
      direct_toolbox profile "$sub" "$@"
      refresh_runtime
      ;;
    *) fail "profile command must be one of: bind, unbind" ;;
  esac
}

kube_toolbox() {
  local kube_dir="${KUBECONFIG_DIR:-$HOME/.kube}"
  [[ -d "$kube_dir" ]] || fail "Kubernetes config directory not found: $kube_dir"
  docker run --rm \
    --network host \
    -v "$kube_dir:/root/.kube:ro" \
    -v "$ROOT:/workspace" \
    -w /workspace \
    --entrypoint bash \
    "$(toolbox_image)" \
    "$@"
}

k8s_command() {
  local sub="${1:-}"
  shift || true
  local namespace="${AGENT_UI_NAMESPACE:-agent-ui}"
  local release="${AGENT_UI_RELEASE:-agent-ui}"
  case "$sub" in
    render|install|upgrade)
      direct_toolbox registry k8s-values --output /workspace/.agent-ui/k8s-values.yaml
      if [[ "$sub" == "render" ]]; then
        kube_toolbox -lc \
          "helm template '$release' /opt/agent-ui/deploy/helm/agent-ui --namespace '$namespace' -f /workspace/.agent-ui/k8s-values.yaml $*"
      else
        kube_toolbox /opt/agent-ui/ops/k8s-install.sh \
          "$release" "$namespace" /workspace/.env /workspace/.agent-ui/k8s-values.yaml "$@"
      fi
      ;;
    uninstall)
      kube_toolbox -lc "helm uninstall '$release' --namespace '$namespace' $*"
      ;;
    status)
      kube_toolbox -lc \
        "helm status '$release' --namespace '$namespace'; kubectl -n '$namespace' get pods,svc,pvc"
      ;;
    *) fail "k8s command must be one of: render, install, upgrade, uninstall, status" ;;
  esac
}

archive_volume() {
  local volume="$1" destination="$2" filename="$3"
  docker run --rm \
    -v "$volume:/source:ro" \
    -v "$destination:/backup" \
    --entrypoint bash \
    "$(toolbox_image)" \
    -lc "tar -czf '/backup/$filename' -C /source ."
}

backup_command() {
  local target="${1:-$ROOT/backups/$(date -u +%Y%m%dT%H%M%SZ)}"
  mkdir -p "$target"
  target="$(cd "$target" && pwd)"
  chmod 0700 "$target"
  compose up -d postgres
  for _ in $(seq 1 60); do
    compose exec -T postgres pg_isready -U "$(env_value POSTGRES_USER)" -d postgres \
      >/dev/null 2>&1 && break
    sleep 2
  done
  compose exec -T postgres pg_dumpall -U "$(env_value POSTGRES_USER)" \
    > "$target/postgres.sql"
  archive_volume "$(env_value HUB_STATE_VOLUME)" "$target" hub-state.tar.gz
  archive_volume "$(env_value GATEWAY_STATE_VOLUME)" "$target" gateway-state.tar.gz
  archive_volume "$(env_value OPEN_WEBUI_VOLUME)" "$target" open-webui.tar.gz
  archive_volume "$(env_value SILLYTAVERN_DATA_VOLUME)" "$target" sillytavern.tar.gz
  archive_volume "$(env_value HERMES_VOLUME)" "$target" hermes.tar.gz
  printf 'Backup written to %s\n' "$target"
}

usage() {
  cat <<'EOF'
Agent UI 0.3 control plane

  ./hub init
  ./hub up [--agent] [--observability]
  ./hub down | status | ports | logs [SERVICE] | restart [SERVICE]
  ./hub registry show|plan|validate|schema|apply FILE
  ./hub source add|list|remove ...
  ./hub provider add ...
  ./hub model register|import|fetch|list|verify|remove ...
  ./hub profile bind|unbind ...
  ./hub doctor | test | lint | smoke | benchmark | switch-regression
  ./hub k8s render|install|upgrade|uninstall|status
  ./hub backup [DIRECTORY]
  ./hub compose ...
EOF
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    init)
      require_docker
      mkdir -p "$GENERATED_DIR"
      build_toolbox
      docker run --rm --network host \
        -v "$ROOT:/workspace" -w /workspace \
        "$(toolbox_image)" env init \
        --template /workspace/.env.example --output /workspace/.env "$@"
      create_volumes
      render_runtime
      show_ports
      ;;
    up)
      ensure_initialized
      build_toolbox
      render_runtime
      local profiles=()
      while (($#)); do
        case "$1" in
          --agent) profiles+=(--profile agent) ;;
          --observability) profiles+=(--profile observability) ;;
          *) fail "unknown up option: $1" ;;
        esac
        shift
      done
      compose "${profiles[@]}" up -d
      show_ports
      ;;
    down) ensure_initialized; compose down "$@" ;;
    status) ensure_initialized; compose ps "$@" ;;
    ports) ensure_initialized; show_ports ;;
    logs) ensure_initialized; compose logs -f --tail=200 "$@" ;;
    restart) ensure_initialized; compose restart "$@" ;;
    compose) ensure_initialized; compose "$@" ;;
    registry) ensure_initialized; registry_command "$@" ;;
    source) ensure_initialized; source_command "$@" ;;
    provider) ensure_initialized; provider_command "$@" ;;
    model) ensure_initialized; model_command "$@" ;;
    profile) ensure_initialized; profile_command "$@" ;;
    doctor) ensure_initialized; toolbox doctor --env-file /workspace/.env "$@" ;;
    test)
      ensure_initialized
      build_toolbox
      docker run --rm -v "$ROOT:/workspace" -w /workspace --entrypoint bash \
        "$(toolbox_image)" -lc 'python -m pytest --cov=local_ai_hub --cov-branch --cov-report=term-missing'
      ;;
    lint)
      ensure_initialized
      build_toolbox
      docker run --rm -v "$ROOT:/workspace" -w /workspace --entrypoint bash \
        "$(toolbox_image)" -lc 'ruff check . && ruff format --check . && bash -n hub ops/*.sh'
      ;;
    smoke) ensure_initialized; "$ROOT/ops/smoke.sh" "$@" ;;
    benchmark) ensure_initialized; "$ROOT/ops/benchmark.sh" "$@" ;;
    switch-regression) ensure_initialized; "$ROOT/ops/switch-regression.sh" "$@" ;;
    k8s) ensure_initialized; k8s_command "$@" ;;
    backup) ensure_initialized; backup_command "$@" ;;
    help|-h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"

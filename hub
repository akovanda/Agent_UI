#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${LOCAL_AI_HUB_ENV_FILE:-$ROOT/.env}"
COMPOSE_FILE="${LOCAL_AI_HUB_COMPOSE_FILE:-$ROOT/compose.yaml}"
DEFAULT_TOOLBOX_IMAGE="local-ai-hub-toolbox:0.2.0"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is required"
  docker version >/dev/null 2>&1 || fail "Docker daemon is not reachable"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required"
}

env_value() {
  local key="$1"
  local fallback="${2:-}"
  if [[ -f "$ENV_FILE" ]]; then
    local value
    value="$(sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1)"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return
    fi
  fi
  printf '%s' "$fallback"
}

toolbox_image() {
  env_value TOOLBOX_IMAGE "$DEFAULT_TOOLBOX_IMAGE"
}

compose() {
  require_docker
  [[ -f "$ENV_FILE" ]] || fail "Run ./hub init first"
  docker compose \
    --project-directory "$ROOT" \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    "$@"
}

build_toolbox() {
  require_docker
  docker build \
    --file "$ROOT/deploy/docker/toolbox.Dockerfile" \
    --tag "$(toolbox_image)" \
    "$ROOT"
}

create_volumes() {
  local names=(
    POSTGRES_VOLUME MODELS_VOLUME RUNTIME_CONFIG_VOLUME HUB_STATE_VOLUME
    GATEWAY_STATE_VOLUME OPEN_WEBUI_VOLUME SILLYTAVERN_CONFIG_VOLUME
    SILLYTAVERN_DATA_VOLUME SILLYTAVERN_PLUGINS_VOLUME
    SILLYTAVERN_EXTENSIONS_VOLUME HERMES_VOLUME PROMETHEUS_VOLUME
  )
  local key name
  for key in "${names[@]}"; do
    name="$(env_value "$key")"
    [[ -n "$name" ]] || fail "$key is empty in $ENV_FILE"
    docker volume create "$name" >/dev/null
  done
}

run_toolbox_root() {
  docker run --rm \
    --network host \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -v "$ROOT:/workspace" \
    -w /workspace \
    "$(toolbox_image)" \
    "$@"
}

run_toolbox_all() {
  local model_volume runtime_volume state_volume hermes_volume
  model_volume="$(env_value MODELS_VOLUME local-ai-hub-models)"
  runtime_volume="$(env_value RUNTIME_CONFIG_VOLUME local-ai-hub-runtime-config)"
  state_volume="$(env_value HUB_STATE_VOLUME local-ai-hub-state)"
  hermes_volume="$(env_value HERMES_VOLUME local-ai-hub-hermes)"
  docker run --rm \
    --network host \
    --env-file "$ENV_FILE" \
    ${HF_TOKEN:+-e HF_TOKEN} \
    -v "$ROOT:/workspace" \
    -v "$model_volume:/models" \
    -v "$runtime_volume:/runtime" \
    -v "$state_volume:/state" \
    -v "$hermes_volume:/hermes" \
    -w /workspace \
    "$(toolbox_image)" \
    "$@"
}

run_toolbox_volumes() {
  local model_volume runtime_volume state_volume hermes_volume
  model_volume="$(env_value MODELS_VOLUME local-ai-hub-models)"
  runtime_volume="$(env_value RUNTIME_CONFIG_VOLUME local-ai-hub-runtime-config)"
  state_volume="$(env_value HUB_STATE_VOLUME local-ai-hub-state)"
  hermes_volume="$(env_value HERMES_VOLUME local-ai-hub-hermes)"
  docker run --rm \
    --env-file "$ENV_FILE" \
    ${HF_TOKEN:+-e HF_TOKEN} \
    -v "$model_volume:/models" \
    -v "$runtime_volume:/runtime" \
    -v "$state_volume:/state" \
    -v "$hermes_volume:/hermes" \
    "$(toolbox_image)" \
    "$@"
}

render_runtime() {
  run_toolbox_volumes runtime render \
    --catalog /opt/local-ai-hub/config/models/catalog.yaml \
    --overlay /state/catalog.local.yaml \
    --models-dir /models \
    --runtime-dir /runtime \
    --hermes-dir /hermes
}

reload_inference_if_running() {
  if docker compose \
      --project-directory "$ROOT" \
      --env-file "$ENV_FILE" \
      -f "$COMPOSE_FILE" \
      ps --status running --services 2>/dev/null | grep -qx llama; then
    compose restart llama >/dev/null
    printf 'Restarted llama.cpp to apply the updated model catalog.\n'
  fi
}

ensure_initialized() {
  if [[ ! -f "$ENV_FILE" ]]; then
    "$ROOT/hub" init
  fi
}

show_ports() {
  local bind
  bind="$(env_value BIND_ADDRESS 127.0.0.1)"
  cat <<EOF
Open WebUI:       http://${bind}:$(env_value OPEN_WEBUI_HOST_PORT)
SillyTavern:      http://${bind}:$(env_value SILLYTAVERN_HOST_PORT)
Gateway API:      http://${bind}:$(env_value GATEWAY_HOST_PORT)/v1
llama.cpp API:    http://${bind}:$(env_value LLAMA_HOST_PORT)/v1
PostgreSQL:       ${bind}:$(env_value POSTGRES_HOST_PORT)
Hermes API:       http://${bind}:$(env_value HERMES_API_HOST_PORT)/v1
Hermes dashboard: http://${bind}:$(env_value HERMES_DASHBOARD_HOST_PORT)
Prometheus:       http://${bind}:$(env_value PROMETHEUS_HOST_PORT)
EOF
}

model_command() {
  local subcommand="${1:-}"
  shift || true
  case "$subcommand" in
    list)
      run_toolbox_volumes model list "$@"
      ;;
    import)
      local model_id="${1:-}"
      local source="${2:-}"
      [[ -n "$model_id" && -n "$source" ]] || \
        fail "usage: ./hub model import MODEL_ID /path/to/model.gguf [--force]"
      shift 2
      source="$(cd "$(dirname "$source")" && pwd)/$(basename "$source")"
      [[ -f "$source" ]] || fail "Model file does not exist: $source"
      local source_dir source_name model_volume state_volume
      source_dir="$(dirname "$source")"
      source_name="$(basename "$source")"
      model_volume="$(env_value MODELS_VOLUME local-ai-hub-models)"
      state_volume="$(env_value HUB_STATE_VOLUME local-ai-hub-state)"
      docker run --rm \
        --env-file "$ENV_FILE" \
        -v "$source_dir:/incoming:ro" \
        -v "$model_volume:/models" \
        -v "$state_volume:/state" \
        "$(toolbox_image)" \
        model import "$model_id" --source "/incoming/$source_name" "$@"
      render_runtime
      reload_inference_if_running
      ;;
    fetch)
      local model_id="${1:-}"
      [[ -n "$model_id" ]] || fail "usage: ./hub model fetch MODEL_ID [options]"
      shift
      run_toolbox_volumes model fetch "$model_id" "$@"
      render_runtime
      reload_inference_if_running
      ;;
    verify)
      local model_id="${1:-}"
      [[ -n "$model_id" ]] || fail "usage: ./hub model verify MODEL_ID [--sha256 HASH]"
      shift
      run_toolbox_volumes model verify "$model_id" "$@"
      ;;
    remove)
      local model_id="${1:-}"
      [[ -n "$model_id" ]] || fail "usage: ./hub model remove MODEL_ID --yes"
      shift
      run_toolbox_volumes model remove "$model_id" "$@"
      render_runtime
      reload_inference_if_running
      ;;
    register)
      local model_id="${1:-}"
      [[ -n "$model_id" ]] || fail "usage: ./hub model register MODEL_ID --filename FILE.gguf [options]"
      shift
      run_toolbox_volumes model register "$model_id" "$@"
      render_runtime
      reload_inference_if_running
      ;;
    render)
      render_runtime
      ;;
    *)
      fail "model command must be one of: list, import, fetch, verify, remove, register, render"
      ;;
  esac
}

kube_mount_args() {
  local kube_dir="${KUBECONFIG_DIR:-$HOME/.kube}"
  [[ -d "$kube_dir" ]] || fail "Kubernetes config directory not found: $kube_dir"
  printf '%s\n' "--network" "host" "-v" "$kube_dir:/root/.kube:ro" "-v" "$ROOT:/workspace"
}

run_kube_toolbox() {
  local args=()
  while IFS= read -r item; do args+=("$item"); done < <(kube_mount_args)
  docker run --rm "${args[@]}" -w /workspace --entrypoint bash "$(toolbox_image)" "$@"
}

k8s_command() {
  local subcommand="${1:-}"
  shift || true
  local namespace="${LOCAL_AI_HUB_NAMESPACE:-local-ai-hub}"
  local release="${LOCAL_AI_HUB_RELEASE:-local-ai-hub}"
  case "$subcommand" in
    render)
      run_toolbox_all catalog k8s-values \
        --catalog /opt/local-ai-hub/config/models/catalog.yaml \
        --overlay /state/catalog.local.yaml \
        --output /workspace/.local-ai-hub-k8s-models.yaml
      run_kube_toolbox -lc \
        "helm template '$release' /opt/local-ai-hub/deploy/helm/local-ai-hub --namespace '$namespace' -f /workspace/.local-ai-hub-k8s-models.yaml $*"
      ;;
    install|upgrade)
      run_toolbox_all catalog k8s-values \
        --catalog /opt/local-ai-hub/config/models/catalog.yaml \
        --overlay /state/catalog.local.yaml \
        --output /workspace/.local-ai-hub-k8s-models.yaml
      run_kube_toolbox /opt/local-ai-hub/ops/k8s-install.sh \
        "$release" "$namespace" /workspace/.env /workspace/.local-ai-hub-k8s-models.yaml "$@"
      ;;
    uninstall)
      run_kube_toolbox -lc "helm uninstall '$release' --namespace '$namespace' $*"
      ;;
    status)
      run_kube_toolbox -lc \
        "helm status '$release' --namespace '$namespace'; kubectl -n '$namespace' get pods,svc,pvc"
      ;;
    model-import)
      local model_id="${1:-}"
      local source="${2:-}"
      [[ -n "$model_id" && -n "$source" ]] || \
        fail "usage: ./hub k8s model-import MODEL_ID /path/to/model.gguf"
      shift 2
      source="$(cd "$(dirname "$source")" && pwd)/$(basename "$source")"
      [[ -f "$source" ]] || fail "Model file does not exist: $source"
      local source_dir source_name destination_name
      source_dir="$(dirname "$source")"
      source_name="$(basename "$source")"
      destination_name="$(run_toolbox_volumes model filename "$model_id")"
      local args=()
      while IFS= read -r item; do args+=("$item"); done < <(kube_mount_args)
      docker run --rm "${args[@]}" \
        -v "$source_dir:/incoming:ro" \
        -w /workspace \
        --entrypoint bash \
        "$(toolbox_image)" \
        /opt/local-ai-hub/ops/k8s-model-import.sh \
        "$release" "$namespace" "$model_id" "/incoming/$source_name" "$destination_name" "$@"
      ;;
    shell)
      run_kube_toolbox
      ;;
    *)
      fail "k8s command must be one of: render, install, upgrade, uninstall, status, model-import, shell"
      ;;
  esac
}

archive_volume() {
  local volume_name="$1"
  local destination_dir="$2"
  local archive_name="$3"
  docker run --rm \
    -v "$volume_name:/source:ro" \
    -v "$destination_dir:/backup" \
    --entrypoint bash \
    "$(toolbox_image)" \
    -lc "tar -czf '/backup/$archive_name' -C /source ."
}

restore_volume_archive() {
  local volume_name="$1"
  local source_dir="$2"
  local archive_name="$3"
  [[ -f "$source_dir/$archive_name" ]] || return 0
  docker volume create "$volume_name" >/dev/null
  docker run --rm \
    -v "$volume_name:/target" \
    -v "$source_dir:/backup:ro" \
    --entrypoint bash \
    "$(toolbox_image)" \
    -lc "find /target -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; tar -xzf '/backup/$archive_name' -C /target"
}

backup_command() {
  ensure_initialized
  build_toolbox
  create_volumes
  local target=""
  local include_models=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --include-models) include_models=true ;;
      *)
        [[ -z "$target" ]] || fail "Only one backup destination may be supplied"
        target="$1"
        ;;
    esac
    shift
  done
  if [[ -z "$target" ]]; then
    target="$ROOT/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  fi
  mkdir -p "$target"
  target="$(cd "$target" && pwd)"
  chmod 0700 "$target"

  local running
  running="$(compose ps --status running --services 2>/dev/null || true)"
  if ! grep -qx postgres <<<"$running"; then
    compose up -d postgres
    for _ in $(seq 1 60); do
      if compose exec -T postgres pg_isready -U "$(env_value POSTGRES_USER)" -d postgres >/dev/null 2>&1; then
        break
      fi
      sleep 2
    done
  fi

  local quiesced=()
  local service
  for service in gateway open-webui sillytavern hermes; do
    if grep -qx "$service" <<<"$running"; then
      quiesced+=("$service")
    fi
  done
  if ((${#quiesced[@]})); then
    compose stop "${quiesced[@]}"
  fi
  restart_quiesced() {
    if ((${#quiesced[@]})); then
      compose start "${quiesced[@]}" >/dev/null 2>&1 || true
    fi
  }
  trap restart_quiesced EXIT

  compose exec -T postgres pg_dump \
    -Fc -U "$(env_value POSTGRES_USER)" -d local_ai_hub \
    > "$target/local_ai_hub.dump"
  compose exec -T postgres pg_dump \
    -Fc -U "$(env_value POSTGRES_USER)" -d open_webui \
    > "$target/open_webui.dump"

  local pairs=(
    "HUB_STATE_VOLUME:hub-state.tar.gz"
    "GATEWAY_STATE_VOLUME:gateway-state.tar.gz"
    "OPEN_WEBUI_VOLUME:open-webui-data.tar.gz"
    "SILLYTAVERN_CONFIG_VOLUME:sillytavern-config.tar.gz"
    "SILLYTAVERN_DATA_VOLUME:sillytavern-data.tar.gz"
    "SILLYTAVERN_PLUGINS_VOLUME:sillytavern-plugins.tar.gz"
    "SILLYTAVERN_EXTENSIONS_VOLUME:sillytavern-extensions.tar.gz"
    "HERMES_VOLUME:hermes-data.tar.gz"
  )
  local pair key archive
  for pair in "${pairs[@]}"; do
    key="${pair%%:*}"
    archive="${pair#*:}"
    archive_volume "$(env_value "$key")" "$target" "$archive"
  done
  if [[ "$include_models" == true ]]; then
    archive_volume "$(env_value MODELS_VOLUME)" "$target" models.tar.gz
  fi

  cp "$ENV_FILE" "$target/environment.env"
  chmod 0600 "$target/environment.env"
  cat > "$target/manifest.txt" <<EOF
version=0.2.0
created_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
compose_project=$(env_value COMPOSE_PROJECT_NAME local-ai-hub)
models_included=$include_models
EOF
  docker run --rm -v "$target:/backup" --entrypoint bash "$(toolbox_image)" \
    -lc 'cd /backup && sha256sum -- * > SHA256SUMS && chmod 0600 SHA256SUMS'
  docker run --rm -v "$target:/backup" --entrypoint chown "$(toolbox_image)" \
    -R "$(id -u):$(id -g)" /backup
  restart_quiesced
  trap - EXIT
  printf 'Backup created: %s\n' "$target"
  printf 'The backup contains plaintext deployment secrets; protect it accordingly.\n'
}

restore_command() {
  ensure_initialized
  build_toolbox
  local source="${1:-}"
  local confirmation="${2:-}"
  [[ -n "$source" && "$confirmation" == "--yes" ]] || \
    fail "usage: ./hub restore /path/to/backup --yes"
  source="$(cd "$source" && pwd)"
  [[ -f "$source/SHA256SUMS" ]] || fail "Backup checksum manifest is missing"
  docker run --rm -v "$source:/backup:ro" --entrypoint bash "$(toolbox_image)" \
    -lc 'cd /backup && sha256sum -c SHA256SUMS'

  compose down --remove-orphans || true
  create_volumes

  local pairs=(
    "HUB_STATE_VOLUME:hub-state.tar.gz"
    "GATEWAY_STATE_VOLUME:gateway-state.tar.gz"
    "OPEN_WEBUI_VOLUME:open-webui-data.tar.gz"
    "SILLYTAVERN_CONFIG_VOLUME:sillytavern-config.tar.gz"
    "SILLYTAVERN_DATA_VOLUME:sillytavern-data.tar.gz"
    "SILLYTAVERN_PLUGINS_VOLUME:sillytavern-plugins.tar.gz"
    "SILLYTAVERN_EXTENSIONS_VOLUME:sillytavern-extensions.tar.gz"
    "HERMES_VOLUME:hermes-data.tar.gz"
    "MODELS_VOLUME:models.tar.gz"
  )
  local pair key archive
  for pair in "${pairs[@]}"; do
    key="${pair%%:*}"
    archive="${pair#*:}"
    restore_volume_archive "$(env_value "$key")" "$source" "$archive"
  done

  local postgres_volume
  postgres_volume="$(env_value POSTGRES_VOLUME)"
  docker volume rm -f "$postgres_volume" >/dev/null 2>&1 || true
  docker volume create "$postgres_volume" >/dev/null
  compose up -d postgres
  local ready=false
  for _ in $(seq 1 90); do
    if compose exec -T postgres pg_isready -U "$(env_value POSTGRES_USER)" -d postgres >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 2
  done
  [[ "$ready" == true ]] || fail "PostgreSQL did not become ready during restore"

  compose exec -T postgres pg_restore \
    --clean --if-exists --no-owner \
    -U "$(env_value POSTGRES_USER)" -d local_ai_hub \
    < "$source/local_ai_hub.dump"
  compose exec -T postgres pg_restore \
    --clean --if-exists --no-owner \
    -U "$(env_value POSTGRES_USER)" -d open_webui \
    < "$source/open_webui.dump"

  render_runtime
  compose up -d --build
  printf 'Restore completed. Run ./hub smoke and verify both interfaces.\n'
}

usage() {
  cat <<'EOF'
Local AI Hub — pure Docker control plane

Usage: ./hub COMMAND [arguments]

Core:
  init [--reallocate-ports] [--rotate-secrets]
  up [--agent] [--observability]
  down | restart | status | logs [service] | ports
  doctor [--gpu] | smoke | test | lint
  switch-regression [ITERATIONS] | benchmark [RUNS]
  backup [DIR] [--include-models]
  restore DIR --yes
  compose ARGS...        Pass through to docker compose
  shell                  Open a toolbox shell

Models:
  model list
  model import MODEL_ID /path/to/model.gguf [--force]
  model fetch MODEL_ID [--repository REPO --file FILE | --url URL]
  model verify MODEL_ID [--sha256 HASH]
  model register MODEL_ID --filename FILE.gguf [options]
  model remove MODEL_ID --yes
  model render

Kubernetes:
  k8s render [helm flags]
  k8s install [helm flags]
  k8s upgrade [helm flags]
  k8s status | k8s uninstall
  k8s model-import MODEL_ID /path/to/model.gguf

Destructive:
  destroy --yes          Remove containers and all managed volumes
EOF
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    init)
      require_docker
      build_toolbox
      run_toolbox_root env init \
        --template /workspace/.env.example \
        --output /workspace/.env \
        "$@"
      create_volumes
      render_runtime
      printf '\nInitialization complete. Import models, then run ./hub up.\n'
      show_ports
      ;;
    up)
      ensure_initialized
      local profiles=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --agent) profiles+=(--profile agent) ;;
          --observability) profiles+=(--profile observability) ;;
          *) fail "Unknown up option: $1" ;;
        esac
        shift
      done
      build_toolbox
      render_runtime
      compose "${profiles[@]}" up -d --build
      show_ports
      ;;
    down)
      compose down "$@"
      ;;
    restart)
      compose restart "$@"
      ;;
    status|ps)
      compose ps "$@"
      ;;
    logs)
      compose logs --follow --tail=200 "$@"
      ;;
    ports)
      ensure_initialized
      show_ports
      ;;
    compose)
      compose "$@"
      ;;
    model)
      ensure_initialized
      build_toolbox
      create_volumes
      model_command "$@"
      ;;
    doctor)
      ensure_initialized
      build_toolbox
      run_toolbox_all doctor \
        --env-file /workspace/.env \
        --catalog /opt/local-ai-hub/config/models/catalog.yaml \
        --overlay /state/catalog.local.yaml
      docker compose version
      if [[ "${1:-}" == "--gpu" ]]; then
        docker run --rm --gpus all nvidia/cuda:12.8.1-base-ubuntu24.04 nvidia-smi
      fi
      ;;
    smoke)
      compose run --rm --no-deps --entrypoint bash toolbox /opt/local-ai-hub/ops/smoke.sh
      ;;
    switch-regression)
      compose run --rm --no-deps --entrypoint bash toolbox \
        /opt/local-ai-hub/ops/switch-regression.sh "${1:-25}"
      ;;
    benchmark)
      compose run --rm --no-deps --entrypoint bash toolbox \
        /opt/local-ai-hub/ops/benchmark.sh "${1:-3}"
      ;;
    test)
      build_toolbox
      docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -v "$ROOT:/workspace" -w /workspace \
        --entrypoint bash "$(toolbox_image)" \
        -lc 'python -m pytest --cov=local_ai_hub --cov-branch --cov-report=term-missing --cov-fail-under=80 && python -m compileall -q services/gateway/src ops'
      ;;
    lint)
      build_toolbox
      docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -v "$ROOT:/workspace" -w /workspace \
        --entrypoint bash "$(toolbox_image)" \
        -lc 'ruff check . && ruff format --check . && bash -n hub ops/*.sh'
      ;;
    shell)
      ensure_initialized
      build_toolbox
      docker run --rm -it --env-file "$ENV_FILE" \
        -v "$ROOT:/workspace" -w /workspace \
        --entrypoint bash "$(toolbox_image)"
      ;;
    k8s)
      ensure_initialized
      build_toolbox
      k8s_command "$@"
      ;;
    backup)
      backup_command "$@"
      ;;
    restore)
      restore_command "$@"
      ;;
    destroy)
      [[ "${1:-}" == "--yes" ]] || fail "destroy requires --yes"
      ensure_initialized
      compose down --remove-orphans || true
      local keys=(
        POSTGRES_VOLUME MODELS_VOLUME RUNTIME_CONFIG_VOLUME HUB_STATE_VOLUME
        GATEWAY_STATE_VOLUME OPEN_WEBUI_VOLUME SILLYTAVERN_CONFIG_VOLUME
        SILLYTAVERN_DATA_VOLUME SILLYTAVERN_PLUGINS_VOLUME
        SILLYTAVERN_EXTENSIONS_VOLUME HERMES_VOLUME PROMETHEUS_VOLUME
      )
      local key name
      for key in "${keys[@]}"; do
        name="$(env_value "$key")"
        [[ -n "$name" ]] && docker volume rm -f "$name" >/dev/null || true
      done
      printf 'Removed Local AI Hub containers and managed volumes.\n'
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      fail "Unknown command: $command"
      ;;
  esac
}

main "$@"
